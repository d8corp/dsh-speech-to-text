__ENV_EXTENDS=.env.theme
INNETJS_ENV_PREFIX=DSH_PLUGIN_SPEECH_TO_TEXT_
RELEASE_COPY_FILES={cordis.patch.yml,client/**/*,locale/**/*,icon.png}
RELEASE_TSCONFIG=tsconfig.release.json
BUILD_FOLDER=client
BUILD_FORMAT=cjs
BUILD_BANNER="window.__ModuleLoader__.load({id:'dsh-speech-to-text',factory(require){var module={exports:{}};var exports=module.exports;"
BUILD_FOOTER="return module.exports}});"
BUILD_EXTERNAL=react,react/jsx-runtime
