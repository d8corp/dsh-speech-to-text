DSH_PLUGIN_SPEECH_TO_TEXT_CSS='.sst-section{color:var(--dsw-alias-label-primary);display:flex;flex-direction:column;font-size:14px;line-height:22px;width:100%}.sst-row{align-items:center;border-bottom:.5px solid var(--dsw-alias-border-l2);display:flex;gap:8px;padding:16px 0}.sst-row:last-of-type{border-bottom:none}.sst-text{flex:1;flex-direction:column;gap:4px;padding-right:48px}.sst-text,.sst-titleRow{display:flex;min-width:0}.sst-titleRow{align-items:center;flex-wrap:wrap;gap:8px}.sst-title{color:var(--dsw-alias-label-primary);font-size:14px;line-height:22px}.sst-desc{color:var(--dsw-alias-label-tertiary);font-size:12px;line-height:18px;white-space:pre-line}.sst-control{align-items:center;display:flex;flex:none;gap:8px;min-width:0}.sst-link{color:var(--dsw-alias-link);cursor:pointer;font:inherit;text-decoration:none;white-space:nowrap}.sst-link:hover{text-decoration:underline}.sst-selectWrap{align-items:center;display:inline-flex;min-width:0;position:relative}.sst-select{appearance:none;-webkit-appearance:none;background:var(--dsw-alias-bg-module-platform);border:none;border-radius:var(--dsw-radius-md);box-sizing:border-box;color:var(--dsw-alias-label-primary);cursor:pointer;font:inherit;font-size:14px;height:36px;line-height:22px;max-width:320px;padding:0 36px 0 14px}.sst-select:hover:not(:disabled){background:var(--dsw-alias-interactive-bg-hover)}.sst-select:disabled{cursor:default;opacity:.5}.sst-select:focus-visible{outline:var(--dsw-focus-ring-width,2px) solid var(--dsw-focus-ring-color,var(--dsw-alias-state-business-primary));outline-offset:2px}.sst-chevron{color:var(--dsw-alias-label-caption);flex:none;pointer-events:none;position:absolute;right:12px}.sst-button{align-items:center;background:transparent;border:.5px solid var(--dsw-alias-border-l3);border-radius:var(--dsw-radius-md);box-sizing:border-box;color:var(--dsw-alias-label-primary);cursor:pointer;display:inline-flex;font:inherit;font-size:12px;height:28px;justify-content:center;line-height:18px;padding:0 10px;white-space:nowrap}.sst-button:hover:not(:disabled){background:var(--dsw-alias-interactive-bg-hover)}.sst-button:disabled{cursor:default;opacity:.4}.sst-button:focus-visible{outline:var(--dsw-focus-ring-width,2px) solid var(--dsw-focus-ring-color,var(--dsw-alias-state-business-primary));outline-offset:2px}.sst-switch{align-items:center;background:none;border:none;cursor:pointer;display:inline-flex;padding:0}.sst-switchTrack{background:var(--dsw-alias-bg-module-platform);border:.5px solid var(--dsw-alias-border-l3);border-radius:999px;display:block;height:22px;position:relative;transition:background .15s ease-in-out;width:40px}.sst-switchOn .sst-switchTrack{background:var(--dsw-alias-state-success-primary);border-color:transparent}.sst-switchThumb{background:var(--dsw-alias-label-primary-foreground);border-radius:50%;display:block;height:16px;left:3px;position:absolute;top:2px;transition:transform .15s ease-in-out;width:16px}.sst-switchOn .sst-switchThumb{transform:translateX(18px)}.sst-switch:disabled{cursor:default;opacity:.4}.sst-switch:focus-visible{outline:var(--dsw-focus-ring-width,2px) solid var(--dsw-focus-ring-color,var(--dsw-alias-state-business-primary));outline-offset:2px}.sst-notice{font-size:12px;line-height:18px;margin:0}.sst-notice-error{color:var(--dsw-alias-state-error-primary)}.sst-loading{border-bottom:.5px solid var(--dsw-alias-border-l2);color:var(--dsw-alias-label-tertiary);font-size:12px;line-height:18px;padding:16px 0}@media (max-width:640px){.sst-row{flex-wrap:wrap}.sst-text{flex-basis:100%;padding-right:0}.sst-control{align-items:stretch;width:100%}.sst-select,.sst-selectWrap{max-width:none;width:100%}}'